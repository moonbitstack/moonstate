// Checkpoints and long-term memory on any SQL backend.
//
// The SQL is written once, against the dialect the driver reports
// (`moonbitstack/moondb`'s `Dialect`), so SQLite, PostgreSQL and MySQL share one
// implementation. The table shape follows
// https://www.sqlite.org/lang_createtable.html and
// https://dev.mysql.com/doc/refman/8.0/en/insert-on-duplicate.html — a key per
// row and one statement that inserts or replaces it.

import {
  "moonbitstack/moondb",
  "moonbitstack/moonstate",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
