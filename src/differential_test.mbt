// The differential suite: the same graphs, built here and in LangGraph 1.2, run
// and compared. The vectors are generated by `scripts/gen_vectors.py`; the spec
// each one was built from travels with it, so both sides run the same shape.

///|
fn object_of(json : Json, what : String) -> Map[String, Json] {
  match json {
    Object(fields) => fields
    _ => abort(what + " is not a JSON object")
  }
}

///|
fn array_of(json : Json, what : String) -> Array[Json] {
  match json {
    Array(items) => items
    _ => abort(what + " is not a JSON array")
  }
}

///|
fn string_of(json : Json) -> String {
  match json {
    String(text) => text
    _ => abort("expected a JSON string, got " + json.stringify())
  }
}

///|
fn text_field(fields : Map[String, Json], key : String) -> String {
  match fields.get(key) {
    Some(json) => string_of(json)
    None => abort("no field '" + key + "'")
  }
}

///|
fn int_of(json : Json) -> Int32 {
  match json {
    Number(value, ..) => value.to_int()
    _ => abort("expected a JSON number, got " + json.stringify())
  }
}

///|
fn int_field(
  fields : Map[String, Json],
  key : String,
  fallback : Int32,
) -> Int32 {
  match fields.get(key) {
    Some(json) => int_of(json)
    None => fallback
  }
}

///|
fn opt_text_field(fields : Map[String, Json], key : String) -> String? {
  match fields.get(key) {
    Some(json) => Some(string_of(json))
    None => None
  }
}

///|
/// One node behaviour, in the vocabulary the vector specs are written in.
enum Op {
  Bump(delta~ : Int32, label~ : String)
  Note(label~ : String)
  LabelN(prefix~ : String)
  Pass
  Goto(to~ : String, label~ : String?)
  Fan(count~ : Int32)
  Gate(label~ : String)
  FailOnce(label~ : String)
  Sub(delta~ : Int32, label~ : String)
}

///|
fn op_of(json : Json) -> Op {
  let fields = object_of(json, "op")
  let kind = text_field(fields, "kind")
  match kind {
    "bump" =>
      Bump(
        delta=int_field(fields, "delta", 1),
        label=text_field(fields, "label"),
      )
    "note" => Note(label=text_field(fields, "label"))
    "label_n" => LabelN(prefix=text_field(fields, "prefix"))
    "pass" => Pass
    "goto" =>
      Goto(to=text_field(fields, "to"), label=opt_text_field(fields, "label"))
    "send" => Fan(count=int_field(fields, "count", 1))
    "gate" => Gate(label=opt_text_field(fields, "label").unwrap_or("gate"))
    "fail_once" => FailOnce(label=text_field(fields, "label"))
    "sub" =>
      Sub(
        delta=int_field(fields, "delta", 0),
        label=opt_text_field(fields, "label").unwrap_or("sub"),
      )
    _ => abort("unknown op '" + kind + "'")
  }
}

///|
/// What a node wrote, in the shape the reference reports: only the fields the
/// node touched, because the reference's update dict only has those keys.
fn patch_json(patch : Patch) -> Json {
  let fields : Map[String, Json] = Map([])
  match patch.n {
    Some(n) => fields["n"] = Json(n)
    None => ()
  }
  match patch.log {
    Some(log) => fields["log"] = @json.to_json(log)
    None => ()
  }
  Json::object(fields)
}

///|
/// The steps one node of the spec produces, in the engine's terms.
fn run_of_op(
  op : Op,
  tries : Ref[Int32],
) -> async (Counter, @moonstate.Run) -> Array[@moonstate.Step[Counter, Patch]] {
  match op {
    Bump(delta~, label~) =>
      (state, _run) => {
        [@moonstate.Write({ n: Some(state.n + delta), log: Some([label]), })]
      }
    Note(label~) =>
      (_state, _run) => [@moonstate.Write({ n: None, log: Some([label]), })]
    LabelN(prefix~) =>
      (state, _run) => {
        [
          @moonstate.Write({
            n: None,
            log: Some([prefix + state.n.to_string()]),
          }),
        ]
      }
    Pass => (_state, _run) => []
    Goto(to~, label~) =>
      (_state, _run) => {
        let steps : Array[@moonstate.Step[Counter, Patch]] = []
        match label {
          Some(label) =>
            steps.push(@moonstate.Write({ n: None, log: Some([label]), }))
          None => ()
        }
        steps.push(@moonstate.Goto(to))
        steps
      }
    Fan(count~) =>
      (_state, _run) => {
        let steps : Array[@moonstate.Step[Counter, Patch]] = []
        for index = 0; index < count; index = index + 1 {
          steps.push(
            @moonstate.Send("worker", {
              n: index,
              log: ["job" + index.to_string()],
            }),
          )
        }
        steps
      }
    Gate(label~) =>
      (_state, run) => {
        match run.answer() {
          Some(answer) => {
            let n = int_of(answer)
            [@moonstate.Write({ n: Some(n), log: Some([label]), })]
          }
          None => [@moonstate.Interrupt({ "ask": "number" })]
        }
      }
    FailOnce(label~) =>
      (state, _run) => {
        tries.val = tries.val + 1
        if tries.val == 1 {
          raise Failure::Failure("the first attempt fails")
        }
        [@moonstate.Write({ n: Some(state.n), log: Some([label]), })]
      }
    Sub(..) =>
      abort("a subgraph node is added by the graph, not by a step list")
  }
}

///|
/// A child graph with the spec's delta, used by the `sub` op.
fn child_of(delta : Int32) -> @moonstate.Graph[Tally, Bump] {
  @moonstate.Builder::new(merge=merge_bump, initial={ hits: 0, })
  .node("grow", (_state, _run) => [@moonstate.Write({ by: Some(delta), })])
  .compile("child") catch {
    refused => abort("refused: " + (refused : Error).to_string())
  }
}

///|
/// Build the graph one vector's spec describes: the same nodes, the same edges,
/// the same branches and retry policies as the reference was given.
fn graph_of(spec : Json) -> @moonstate.Graph[Counter, Patch] {
  let fields = object_of(spec, "spec")
  let nodes = array_of(fields.get("nodes").unwrap(), "nodes")
  let edges = match fields.get("edges") {
    Some(json) => array_of(json, "edges")
    None => []
  }
  let retries = match fields.get("retry") {
    Some(Object(retries)) => retries
    _ => Map([])
  }
  let mut builder = @moonstate.Builder::new(merge=merge_patch, initial=zero())
  let ids : Array[String] = []
  for node in nodes {
    let id = text_field(object_of(node, "node"), "id")
    ids.push(id)
    let op = op_of(object_of(node, "node").get("op").unwrap())
    let tries = Ref(0)
    let attempts = match retries.get(id) {
      Some(json) => int_of(json)
      None => 1
    }
    match op {
      Sub(delta~, label~) =>
        builder = builder.subgraph(
          id,
          child_of(delta),
          enter=state => ({ hits: state.n, } : Tally),
          leave=tally => count(tally.hits, label),
        )
      _ =>
        builder = builder.node(id, run_of_op(op, tries), retry=@moonstate.Retry::{
          attempts,
          delay: 0,
        })
    }
  }
  match fields.get("worker") {
    Some(worker) => {
      builder = builder.node("worker", run_of_op(op_of(worker), Ref(0)), retry=@moonstate.Retry::{
        attempts: 1,
        delay: 0,
      })
      ids.push("worker")
    }
    None => ()
  }
  let reached : Array[String] = []
  for edge in edges {
    let pair = array_of(edge, "edge")
    let from = string_of(pair[0])
    let to = string_of(pair[1])
    if from == "START" {
      builder = builder.entry(to)
      reached.push(to)
    } else if to != "END" {
      builder = builder.edge(from, to)
      reached.push(to)
    }
  }
  match fields.get("branches") {
    Some(branches) =>
      for branch in array_of(branches, "branches") {
        let branch_fields = object_of(branch, "branch")
        let from = text_field(branch_fields, "from")
        let cases = array_of(branch_fields.get("cases").unwrap(), "cases")
        let fallback = match branch_fields.get("default") {
          Some(json) => array_of(json, "default").map(name => string_of(name))
          None => []
        }
        let route : async (Counter) -> Array[String] = state => {
          let mut chosen = fallback
          let mut matched = false
          for case in cases {
            let case_fields = object_of(case, "case")
            if !matched && state.n >= int_field(case_fields, "n_at_least", 0) {
              chosen = array_of(case_fields.get("to").unwrap(), "to").map(name => {
                string_of(name)
              })
              matched = true
            }
          }
          chosen
        }
        builder = builder.branch(from, route)
      }
    None => ()
  }
  // A node the edges do not reach is entered at run time — by a `Send` or a
  // `Goto` — which is what the builder has to be told.
  for id in ids {
    if !reached.contains(id) {
      builder = builder.routed(id)
    }
  }
  builder.compile(
    "vector",
    saver=@moonstate.MemorySaver::new(),
    limit=int_field(fields, "limit", 25),
  ) catch {
    refused => abort("refused: " + (refused : Error).to_string())
  }
}

///|
/// The events one run reported, in the reference's shape: one entry per finished
/// node, carrying what it wrote.
fn events_of(events : Array[Json]) -> Json {
  Json::array(events)
}

///|
async fn run_and_collect(
  graph : @moonstate.Graph[Counter, Patch],
  input : Patch,
  thread : String,
) -> (Array[Json], Json?) {
  let events : Array[Json] = []
  let writes : Array[Json] = []
  let on : async (@moonstate.Event[Counter, Patch]) -> Unit = event => {
    match event {
      @moonstate.Started(..) => writes.clear()
      @moonstate.Updates(node~, update) => {
        let _ = node
        writes.push(patch_json(update))
      }
      @moonstate.Finished(node~) => {
        let update = if writes.length() > 0 {
          writes[0]
        } else {
          Json::object(Map([]))
        }
        events.push({ "node": node, "update": update })
        writes.clear()
      }
      _ => ()
    }
  }
  let stopped = try {
    let _ = graph.stream(input, on, thread~)
    None
  } catch {
    @moonstate.Interrupted(thread~, value~) => {
      let _ = thread
      Some(value)
    }
    error => raise error
  }
  (events, stopped)
}

///|
fn expect_same(
  label : String,
  actual : Json,
  expected : Json,
) -> Unit raise Failure {
  if actual != expected {
    raise Failure::Failure(
      label +
      "\n  want " +
      expected.stringify() +
      "\n  got  " +
      actual.stringify(),
    )
  }
}

///|
async fn check_vector(vector : Json) -> Unit raise Failure {
  let fields = object_of(vector, "vector")
  let name = text_field(fields, "name")
  let spec = fields.get("spec").unwrap()
  let graph = graph_of(spec)
  let spec_fields = object_of(spec, "spec")
  let input : Patch = @json.from_json(spec_fields.get("input").unwrap()) catch {
    error => abort("input: " + (error : Error).to_string())
  }
  let thread = "t"
  let (events, stopped) = run_and_collect(graph, input, thread) catch {
    error =>
      raise Failure::Failure(
        name + ": run failed: " + (error : Error).to_string(),
      )
  }
  let interrupt = match fields.get("interrupt") {
    Some(Null) | None => None
    Some(payload) => Some(payload)
  }
  expect_same(name + " events", events_of(events), fields["events"])
  match interrupt {
    None =>
      match stopped {
        None => ()
        Some(value) =>
          abort(
            name +
            ": stopped at an interrupt it does not expect: " +
            value.stringify(),
          )
      }
    Some(payload) => {
      // The run above stopped at the interrupt; the state says what it waits on.
      let state = (graph.state(thread) catch {
        error =>
          raise Failure::Failure(
            name + ": state: " + (error : Error).to_string(),
          )
      }).unwrap()
      expect_same(name + " interrupt", state.interrupt.unwrap(), payload)
      let answer = spec_fields.get("resume").unwrap()
      let resumed : Array[Json] = []
      let writes : Array[Json] = []
      let on : async (@moonstate.Event[Counter, Patch]) -> Unit = event => {
        match event {
          @moonstate.Started(..) => writes.clear()
          @moonstate.Updates(node~, update) => {
            let _ = node
            writes.push(patch_json(update))
          }
          @moonstate.Finished(node~) => {
            let update = if writes.length() > 0 {
              writes[0]
            } else {
              Json::object(Map([]))
            }
            resumed.push({ "node": node, "update": update })
            writes.clear()
          }
          _ => ()
        }
      }
      let finished = graph.resume_stream(thread, answer, on) catch {
        error =>
          raise Failure::Failure(
            name + ": resume: " + (error : Error).to_string(),
          )
      }
      let resumed_expected = object_of(
        fields.get("resumed").unwrap(),
        "resumed",
      )
      expect_same(
        name + " resumed events",
        events_of(resumed),
        resumed_expected["events"],
      )
      expect_same(
        name + " resumed state",
        @json.to_json(finished),
        resumed_expected["final"],
      )
    }
  }
  match fields.get("snapshots") {
    Some(Null) | None => ()
    Some(expected) => {
      let history = graph.history(thread) catch {
        error =>
          raise Failure::Failure(
            name + ": history: " + (error : Error).to_string(),
          )
      }
      let actual : Array[Json] = []
      for snapshot in history {
        actual.push({
          "values": @json.to_json(snapshot.state),
          "next": Json::array(snapshot.next.map(node => Json(node))),
          "step": Json(snapshot.step),
          "interrupted": Json(snapshot.interrupt is Some(_)),
        })
      }
      expect_same(name + " snapshots", Json::array(actual), expected)
    }
  }
  match fields.get("after") {
    Some(Null) | None => ()
    Some(after) => {
      let after_fields = object_of(after, "after")
      let rewrite = spec_fields.get("after").unwrap()
      let rewrite_fields = object_of(rewrite, "after spec")
      let write : Patch = @json.from_json(rewrite_fields.get("write").unwrap()) catch {
        error =>
          raise Failure::Failure(
            name + ": rewrite: " + (error : Error).to_string(),
          )
      }
      let as_node = opt_text_field(rewrite_fields, "as_node")
      match as_node {
        Some(node) =>
          graph.update(thread, write, as_node=node) catch {
            error =>
              raise Failure::Failure(
                name + ": update: " + (error : Error).to_string(),
              )
          }
        None =>
          graph.update(thread, write) catch {
            error =>
              raise Failure::Failure(
                name + ": update: " + (error : Error).to_string(),
              )
          }
      }
      let (events, _) = run_and_collect(graph, input, thread) catch {
        error =>
          raise Failure::Failure(
            name + ": after run: " + (error : Error).to_string(),
          )
      }
      expect_same(
        name + " after events",
        events_of(events),
        after_fields["events"],
      )
      let finished = (graph.state(thread) catch {
        error =>
          raise Failure::Failure(
            name + ": state: " + (error : Error).to_string(),
          )
      }).unwrap()
      expect_same(
        name + " after state",
        @json.to_json(finished.state),
        after_fields["final"],
      )
    }
  }
}

///|
async test "every differential vector matches LangGraph 1.2" {
  let text = StringBuilder()
  for chunk in vector_chunks {
    text.write_string(chunk)
  }
  let parsed = @json.parse(text.to_string()) catch {
    error => abort("vectors: " + (error : Error).to_string())
  }
  let vectors = array_of(parsed, "vectors")
  assert_eq(vectors.length(), 24)
  for vector in vectors {
    check_vector(vector) catch {
      error => fail("a vector failed: " + (error : Error).to_string())
    }
  }
}
